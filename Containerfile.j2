ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="ca_root_nss"
ARG APP_VERSION=""
ARG UPSTREAM_URL="https://api.github.com/repos/henrygd/beszel/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:8090/api/health"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.documentation="https://beszel.dev/guide/what-is-beszel" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install root certificates for outbound HTTPS notifications, OIDC, and agent calls
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Download and verify the official Beszel FreeBSD release binary
RUN set -eux; \
    VERSION="${APP_VERSION}"; \
    if [ -z "${VERSION}" ]; then \
        VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}"); \
    fi; \
    test -n "${VERSION}" && [ "${VERSION}" != "null" ]; \
    CLEAN_VER="${VERSION#v}"; \
    case "${FREEBSD_ARCH}" in \
        amd64) BIN_ARCH="amd64" ;; \
        *) echo "Unsupported architecture: ${FREEBSD_ARCH}" >&2; exit 1 ;; \
    esac; \
    ASSET="beszel_freebsd_${BIN_ARCH}.tar.gz"; \
    CHECKSUMS="beszel_${CLEAN_VER}_checksums.txt"; \
    BASE_DL="https://github.com/henrygd/beszel/releases/download/${VERSION}"; \
    fetch -qo "/tmp/${ASSET}" "${BASE_DL}/${ASSET}"; \
    fetch -qo "/tmp/${CHECKSUMS}" "${BASE_DL}/${CHECKSUMS}"; \
    EXPECTED_SHA=$(awk -v f="${ASSET}" '$2 == f { print $1 }' "/tmp/${CHECKSUMS}"); \
    ACTUAL_SHA=$(sha256 -q "/tmp/${ASSET}"); \
    test -n "${EXPECTED_SHA}" && [ "${EXPECTED_SHA}" = "${ACTUAL_SHA}" ]; \
    tar -xzf "/tmp/${ASSET}" -C /tmp beszel; \
    install -m 0755 /tmp/beszel /usr/local/bin/beszel; \
    mkdir -p /app /config/beszel_data; \
    printf '%s\n' "${CLEAN_VER}" > /app/version; \
    chmod -R a+rX /app; \
    chown -R bsd:bsd /config; \
    rm -f "/tmp/${ASSET}" "/tmp/${CHECKSUMS}" /tmp/beszel

COPY root/ /
RUN chmod +x /daemonless/libexec/beszel

WORKDIR /config
CMD ["/daemonless/libexec/beszel"]

EXPOSE 8090
VOLUME /config
